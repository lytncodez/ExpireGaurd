# Leave VITE_API_URL empty in development: the app calls /api and Vite proxies it to the backend.
# For a production build served separately from the API, set the backend's public URL, e.g.
# VITE_API_URL=https://api.example.com
VITE_API_URL=
# Where the dev proxy forwards /api (defaults to http://localhost:8000)
# VITE_BACKEND_URL=http://localhost:8000
