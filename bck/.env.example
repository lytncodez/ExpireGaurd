ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://expireguard:expireguard@localhost:5432/expireguard

JWT_SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

EXPIRY_CRITICAL_DAYS=30
EXPIRY_SOON_DAYS=90

MAX_UPLOAD_MB=5
CORS_ORIGINS=http://localhost:3000

SMS_MODE=mock
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=ExpireGuard

AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

SCHEDULER_ENABLED=false
EXPIRY_JOB_HOUR=6

# Used by docker-compose for the Postgres container
POSTGRES_USER=expireguard
POSTGRES_PASSWORD=expireguard
POSTGRES_DB=expireguard
