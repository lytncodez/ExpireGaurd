# Copy to .env and adjust. Never commit .env.

# --- Application ---
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database (local run; docker-compose overrides the host to "db") ---
POSTGRES_USER=expireguard
POSTGRES_PASSWORD=expireguard
POSTGRES_DB=expireguard
DATABASE_URL=postgresql+asyncpg://expireguard:expireguard@localhost:5432/expireguard
TEST_DATABASE_URL=postgresql+asyncpg://expireguard:expireguard@localhost:5432/expireguard_test

# --- Auth (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))") ---
JWT_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESET_TOKEN_EXPIRE_MINUTES=30

# --- Rate limiting (in-process; use Redis-backed limiting when running several workers) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=5

# --- Pharmacy (one pharmacy per install) ---
PHARMACY_NAME=My Pharmacy          # name given to the pharmacy when the first user signs up
PHARMACY_CURRENCY=GHS
PHARMACY_TIMEZONE=Africa/Accra
# Numbers typed like 0241234567 get this country code (+233 = Ghana)
DEFAULT_PHONE_COUNTRY_CODE=+233
ALLOW_PUBLIC_SIGNUP=true           # later sign-ups join as dispensers; set false in production
ALLOW_MULTIPLE_COMPANIES=false     # multi-tenant mode (the test suite turns this on)

# --- Default risk bands for a new pharmacy (days; admins edit them in Settings) ---
EXPIRY_CRITICAL_DAYS=7
EXPIRY_ACTION_DAYS=30
EXPIRY_MONITOR_DAYS=60
EXPIRY_ADVISORY_DAYS=90

# --- Inventory ---
ALLOW_NEGATIVE_INVENTORY=false
LOW_STOCK_THRESHOLD=10

# --- SMS ---
SMS_MODE=mock                  # mock | live
SMS_PROVIDER=africastalking    # africastalking | twilio (used when SMS_MODE=live)
SMS_MIN_SEVERITY=CRITICAL      # INFO | WARNING | CRITICAL | URGENT
SMS_TIMEOUT_SECONDS=10
SMS_MAX_ATTEMPTS=3
SMS_SENDER_ID=
AT_USERNAME=
AT_API_KEY=
AT_SANDBOX=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Email alerts (SMTP) ---
# off | mock (logs emails in the backend window) | live (really sends)
EMAIL_MODE=mock
# smtp = Gmail/SMTP (works locally). brevo = HTTPS API (use on Render free, which blocks SMTP ports)
EMAIL_PROVIDER=smtp
BREVO_API_KEY=
EMAIL_MIN_SEVERITY=CRITICAL    # INFO | WARNING | CRITICAL | URGENT
# Gmail: turn on 2-Step Verification, create an App Password, and use it below (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls         # starttls (port 587) | ssl (port 465) | none
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=ExpireGuard

# --- Imports ---
MAX_UPLOAD_SIZE_MB=10
MAX_IMPORT_ROWS=50000
IMPORT_DATE_DAYFIRST=true      # 03/04/2027 = 3 April (false = 4 March)

# --- Analytics / anomaly detection ---
ANALYTICS_DEFAULT_DAYS=30
ANOMALY_BASELINE_DAYS=28
ANOMALY_RECENT_DAYS=7
ANOMALY_Z_THRESHOLD=2.5
ANOMALY_MIN_PCT_CHANGE=50
ANOMALY_HIGH_COVER_DAYS=180
ANOMALY_LOW_COVER_DAYS=3

# --- AI intelligence layer (Phase 2) ---
# mock works with no credentials. openai/anthropic need BOTH key and model, otherwise mock is used.
AI_PROVIDER=mock               # mock | openai | anthropic  (use anthropic/openai for open questions & marketing advice)
OPENAI_API_KEY=
OPENAI_MODEL=                  # e.g. a current OpenAI chat model name
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=               # e.g. a current Claude model name
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
AI_TIMEOUT_SECONDS=45
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.2
AI_CHAT_HISTORY_MESSAGES=10
AI_CONTEXT_LIST_LIMIT=10
AI_RATE_LIMIT_PER_MINUTE=20

# --- Background jobs (UTC) ---
SCHEDULER_ENABLED=true
EXPIRY_JOB_HOUR=6
EXPIRY_JOB_MINUTE=0
# Daily expiry email to all admins after the morning check (also switchable per pharmacy in Settings)
EMAIL_DIGEST_ENABLED=true
ALERT_JOB_INTERVAL_MINUTES=30
CLEANUP_JOB_HOUR=3
ALERT_RETENTION_DAYS=180
