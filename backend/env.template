# ExpireGuard Environment Configuration

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/expireguard

# JWT
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# App
APP_NAME=ExpireGuard
DEBUG=True

# ============================================================================
# SMS Configuration
# ============================================================================

# SMS Provider: MOCK | TWILIO | AFRICASTALKING
# MOCK = Simulates SMS (for development/testing)
# TWILIO = Send real SMS via Twilio
# AFRICASTALKING = Send real SMS via Africa's Talking
SMS_PROVIDER=MOCK

# ============================================================================
# Twilio SMS Configuration (if SMS_PROVIDER=TWILIO)
# ============================================================================
# Get credentials from: https://www.twilio.com/console

TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890  # Your Twilio phone number

# ============================================================================
# Africa's Talking SMS Configuration (if SMS_PROVIDER=AFRICASTALKING)
# ============================================================================
# Get credentials from: https://africastalking.com/

AFRICASTALKING_API_KEY=your_africastalking_api_key_here
AFRICASTALKING_USERNAME=your_africastalking_username_here

# ============================================================================
# Alert Configuration (Optional - defaults provided)
# ============================================================================

# Default recipient phone number for alerts
# If not set per batch, will try this number
ALERT_DEFAULT_PHONE_NUMBER=

# Expiry status thresholds (days)
# Override these to customize when alerts are triggered
EXPIRY_THRESHOLD_CRITICAL_MIN=1
EXPIRY_THRESHOLD_CRITICAL_MAX=30
EXPIRY_THRESHOLD_EXPIRING_SOON_MIN=31
EXPIRY_THRESHOLD_EXPIRING_SOON_MAX=90
